---
import { site } from '../data/site';

interface Props {
  active: 'current' | 'cosmic' | 'giorno';
  tone?: 'current' | 'neon';
}

const { active, tone = 'neon' } = Astro.props;
const versions = [
  { id: 'current', label: 'Current', href: site.links.home },
  { id: 'cosmic', label: 'Cosmic', href: site.links.cosmic },
  { id: 'giorno', label: 'Giorno', href: site.links.giorno },
] as const;
---

<nav class:list={['version-switcher', `version-switcher--${tone}`]} aria-label="Design experiment versions">
  <span class="version-switcher__label" aria-hidden="true">View</span>
  <div>
    {versions.map((version, index) => (
      <>
        {index > 0 && <span class="version-switcher__dot" aria-hidden="true">·</span>}
        <a href={version.href} aria-current={active === version.id ? 'page' : undefined}>{version.label}</a>
      </>
    ))}
  </div>
</nav>
