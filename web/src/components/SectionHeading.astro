---
interface Props {
  id?: string;
  label: string;
  title: string;
  intro?: string;
}

const { id, label, title, intro } = Astro.props;
---

<header class="section-heading">
  <p class="section-label">{label}</p>
  <h2 {id}>{title}</h2>
  {intro && <p class="section-intro">{intro}</p>}
</header>
