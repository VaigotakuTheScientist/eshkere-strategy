---
import { site } from '../data/site';

interface Props {
  currentPath?: '/' | '/strategy';
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={site.links.home} aria-label="Eshkere Strategy home">
      <span class="wordmark-mark" aria-hidden="true">ES</span>
      <span>{site.name}</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href={site.links.home} aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
      <a href={site.links.strategy} aria-current={currentPath === '/strategy' ? 'page' : undefined}>Strategy</a>
      <a href={site.links.githubRepository}>GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
