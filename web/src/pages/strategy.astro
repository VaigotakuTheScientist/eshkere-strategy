---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StrategyCard from '../components/StrategyCard.astro';
import { acquisitionRoutes, operatingLoop, powerCategories, site } from '../data/site';

const title = 'Strategy — Eshkere Strategy';
const description = 'How I identify bottlenecks, build capital, capabilities, productivity and influence, and direct them toward useful AI-safety work.';

const principles = [
  'AI-safety impact is the objective; income is a means.',
  'Resources should eventually be deployed, not accumulated as status objects.',
  'Prefer aligned work that both pays and builds relevant capacity.',
  'Avoid unrelated work whose time cost erodes the trajectory unless it is necessary for stability.',
  'Prefer options that improve multiple forms of power simultaneously.',
  'Preserve option value when uncertainty is high.',
  'Use cheap experiments before large commitments.',
  'Replace assumptions and estimates when evidence changes.',
  'Account for time, health, stress, opportunity cost, and downside risk.',
  'Strategies should be legal, ethically defensible, and compatible with AI safety.',
];

const exclusions = [
  'A claim that money or power are intrinsically valuable',
  'A fixed five-year plan',
  'A commitment to one AI-safety career path',
  'A complete representation of my life or values',
  'The broader Eshkere philosophy',
];
---

<BaseLayout {title} {description} currentPath="/strategy">
  <header class="page-hero shell" data-reveal>
    <p class="eyebrow">Eshkere Strategy / working model</p>
    <h1>The strategy</h1>
    <p>Given where I am now, what should I acquire, build, pursue, deploy, or stop doing to maximize my useful contribution to AI safety?</p>
  </header>

  <section class="content-section shell" id="horizons" aria-labelledby="horizons-heading" data-reveal>
    <SectionHeading id="horizons-heading" label="Direction / 01" title="Objective and horizons" />
    <div class="section-body horizon-grid">
      <article>
        <p class="horizon-time">Ultimate objective</p>
        <h3>Maximize useful contribution to AI safety.</h3>
        <p>Everything else is instrumental and should be evaluated by how it changes my expected ability to help with that objective.</p>
      </article>
      <article>
        <p class="horizon-time">Near-term horizon</p>
        <h3>Remove the financial and runway bottleneck.</h3>
        <p>Secure sufficient, reasonably stable support while continuing to build an AI-safety career.</p>
      </article>
      <article>
        <p class="horizon-time">3–5 year horizon</p>
        <h3>Build relevant power and capacity.</h3>
        <p>Accumulate capital, capabilities, productivity, and influence that can be deployed toward consequential work—not merely held.</p>
      </article>
      <p class="instrumental-note">Basic income is a current bottleneck—not the terminal objective.</p>
    </div>
  </section>

  <section class="content-section shell" id="bottleneck" aria-labelledby="bottleneck-heading" data-reveal>
    <SectionHeading id="bottleneck-heading" label="Constraint / 02" title="Current bottleneck" />
    <div class="section-body split-copy">
      <div>
        <p class="lead-statement">Financial pressure narrows the set of actions I can take.</p>
        <p>The target is not maximum income in isolation. It is enough dependable runway that ordinary living costs stop demanding disproportionate attention while learning, tools, productive working conditions, travel, and relocation become available when their expected value is high.</p>
      </div>
      <div>
        <p class="mini-heading">Solving it should create</p>
        <ul class="consequence-list">
          <li>Less cognitive load from basic finances</li>
          <li>Career travel when the expected value is high</li>
          <li>Better equipment and working conditions</li>
          <li>Ability to accept strategically valuable opportunities</li>
          <li>Greater relocation optionality</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="content-section shell" id="power" aria-labelledby="strategy-power-heading" data-reveal>
    <SectionHeading id="strategy-power-heading" label="Resources / 03" title="Power model" intro="Power means practical capacity to understand, coordinate, build, and act. The four categories interact; none is sufficient alone." />
    <div class="section-body">
      <div class="power-sequence" aria-label="Capital, capabilities, productivity, and influence are interconnected forms of power">
        {powerCategories.map((category, index) => (
          <StrategyCard number={String(index + 1).padStart(2, '0')} title={category.title} description={category.description} />
        ))}
      </div>
      <p class="section-closing">The point is not to possess these resources. It is to convert them into better decisions and more useful action, then direct that action toward AI safety.</p>
    </div>
  </section>

  <section class="content-section shell" id="routes" aria-labelledby="strategy-routes-heading" data-reveal>
    <SectionHeading id="strategy-routes-heading" label="Inputs / 04" title="Resource-acquisition routes" />
    <div class="section-body">
      <ol class="route-list strategy-route-list">
        {acquisitionRoutes.map((route, index) => (
          <li>
            <span class="route-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div><p class="route-emphasis">{route.emphasis}</p><h3>{route.title}</h3></div>
            <p>{route.description}</p>
          </li>
        ))}
      </ol>
      <aside class="field-note">
        <p class="memo-label">Important distinction</p>
        <p>These describe how resources are acquired. They are different from career paths such as technical AI safety, governance, field-building, operations or generalist work, or entrepreneurship. Aligned employment and projects are preferable when they solve the financial problem while compounding relevant capacity.</p>
      </aside>
    </div>
  </section>

  <section class="content-section loop-section shell" id="operating-loop" aria-labelledby="loop-heading" data-reveal>
    <SectionHeading id="loop-heading" label="Method / 05" title="Operating loop" intro="The strategy is a feedback system, not a fixed plan." />
    <div class="section-body">
      <figure class="loop-visual">
        <img src={`${import.meta.env.BASE_URL}/operating-loop.svg`} alt="The operating loop identifies bottlenecks, acquires resources, converts them into power, deploys that power toward AI safety, and then reviews the results." width="1200" height="400" />
      </figure>
      <ol class="loop-visual-mobile" aria-label="Eshkere Strategy operating loop">
        {operatingLoop.map((step, index) => (
          <li class:list={{ 'is-action': index === operatingLoop.length - 1 }}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {step.shortTitle}
          </li>
        ))}
      </ol>
      <p class="section-closing">Each cycle should leave behind evidence: what changed, what failed, and which constraint now matters most. When the evidence changes, the strategy should change with it.</p>
      <ol class="loop-grid">
        {operatingLoop.map((step, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="content-section shell" id="principles" aria-labelledby="principles-heading" data-reveal>
    <SectionHeading id="principles-heading" label="Judgment / 06" title="Decision principles" />
    <div class="section-body">
      <ol class="principle-list">
        {principles.map((principle, index) => (
          <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{principle}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="content-section shell" id="boundaries" aria-labelledby="not-heading" data-reveal>
    <SectionHeading id="not-heading" label="Boundaries / 07" title="What this strategy is not" />
    <div class="section-body">
      <ul class="not-list">
        {exclusions.map((item) => <li><span aria-hidden="true">Not</span>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="closing-section shell" aria-labelledby="closing-heading" data-reveal>
    <p class="section-label">From model to movement / 08</p>
    <h2 id="closing-heading">Strategy is useful only if it changes action.</h2>
    <div class="button-row">
      <a class="button button-primary" href={`${site.links.home}#now`}>See what I’m doing now <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href={site.links.githubRepository}>View the working repository <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
