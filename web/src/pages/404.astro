---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Page not found — Eshkere Strategy" description="The requested page could not be found." noindex>
  <section class="not-found shell">
    <p class="eyebrow">404 / Wrong orbit</p>
    <h1>Lost in the game.</h1>
    <p>This page does not exist. Return to Eshkere Strategy and choose the next useful move.</p>
    <a class="button button-primary" href={site.links.home}>Back to Eshkere Strategy <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
